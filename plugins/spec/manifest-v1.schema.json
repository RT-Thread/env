{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.rt-thread.org/schemas/env/epack/manifest-v1.schema.json",
  "title": "RT-Thread Env .epack v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "description",
    "author",
    "license",
    "compatibility",
    "permissions",
    "commands",
    "backend"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+){2}(?:[-+][A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)*)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "file"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^licenses/.+"
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "env",
        "python",
        "implementations",
        "abis",
        "platforms",
        "architectures"
      ],
      "properties": {
        "env": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "implementations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "cpython"
            ]
          }
        },
        "abis": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:py3|cp[0-9]{2,3})$"
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "any",
              "linux",
              "windows",
              "darwin"
            ]
          }
        },
        "architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "any",
              "x86_64",
              "x86",
              "aarch64",
              "arm",
              "riscv64"
            ]
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "reason",
          "required"
        ],
        "properties": {
          "name": {
            "enum": [
              "workspace.read",
              "workspace.write",
              "process.execute",
              "network.access",
              "credentials.use",
              "device.serial"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "entry",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          },
          "entry": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "format",
              "role"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^backend/.+\\.whl$"
              },
              "format": {
                "enum": [
                  "source-wheel",
                  "pyc-wheel"
                ]
              },
              "role": {
                "enum": [
                  "plugin",
                  "dependency"
                ]
              }
            }
          }
        }
      }
    },
    "health_check": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "health_path",
        "start_timeout"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_]*$"
        },
        "health_path": {
          "type": "string",
          "pattern": "^/(?!.*(?:^|/)\\.\\.?/)[^:]*$"
        },
        "start_timeout": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        }
      }
    },
    "webui": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry",
        "icon",
        "frontend_sdk"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "pattern": "^frontend/(?!.*(?:^|/)\\.\\.?/).+\\.html$"
        },
        "icon": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "frontend_sdk": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "anyOf": [
    {"properties": {"commands": {"minItems": 1}}},
    {"required": ["webui"]},
    {"required": ["health_check"]},
    {"required": ["service"]}
  ]
}
